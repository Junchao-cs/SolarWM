include assets/solar-logo.svg
include assets/solar-logo-transparent.png
include assets/solar-logo-dark.png
include assets/solarwm-demo-poster.png
include assets/solarrenderer-demo.gif
include deploy/__init__.py
include deploy/README.md
include CONTRIBUTING.md
include NOTICE
include SECURITY.md
include data-engine/README.md
recursive-include .github *.yml
recursive-include configs *.yaml
recursive-include docs *.md
recursive-include deploy/solar_wm *.md *.txt *.json *.sh *.png *.html *.js *.c *.pt
include deploy/solar_wm/.ruff.toml
recursive-include deploy/solar_renderer/comfyui *.py *.md *.json *.html *.png
recursive-include deploy/solar_renderer/reactor *.py *.md *.yaml *.txt *.json *.ts *.tsx *.css *.html *.png
recursive-include deploy/solar_renderer/reactor LICENSE NOTICE .dockerignore .gitignore
prune deploy/solar_renderer/reactor/demo/node_modules
prune deploy/solar_renderer/reactor/demo/dist
prune deploy/solar_renderer/reactor/.solarwm-source
recursive-include eval/solar_renderer *.py *.md *.sh
recursive-include examples/solar_renderer *.txt *.png *.mp4
recursive-include examples/solar_wm *.md *.txt *.png
recursive-include skills *.md *.py
recursive-include tests *.py
recursive-include tools *.py
